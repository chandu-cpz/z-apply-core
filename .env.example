DEFAULT_USERNAME=
DEFAULT_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Model provider: "opengateway", "groq", "orca", "agnes", "inferx", or "opencodego". Leave empty to
# auto-detect from whichever provider API key is set.
MODEL_PROVIDER=

# OpenGateway (opengateway.gitlawb.com) provider key and model override.
OGW_API_KEY=
OGW_MODEL=inclusionai/ling-3.0-flash:free

# Groq hosted endpoint provider key and model override.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# OrcaRouter (api.orcarouter.ai) provider key and model override.
ORCA_API_KEY=
ORCA_MODEL=qwen/qwen3.8-27b-free

# Agnes AI (free) provider key and model override (default: agnes-2.0-flash).
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash

# InferX hosted endpoint provider key and model override.
INFERX_API_KEY=
INFERX_MODEL=deepseek-v4-flash-0731
